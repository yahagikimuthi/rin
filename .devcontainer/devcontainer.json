{
    "name": "rin container",
    "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu-24.04",
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "runArgs": [
        "-e",
        "DISPLAY=${env:DISPLAY}",
        "-v",
        "/tmp/.X11-unix:/tmp/.X11-unix:rw",
        "--device=/dev/dri:/dev/dri"
    ]
}